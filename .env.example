# Copy to .env and fill in your own values. Never commit .env.
# Only the variables the code actually reads are listed here.

# LLM provider: auto (Groq -> Cerebras -> SambaNova -> Ollama) | groq | cerebras | sambanova | ollama
LLM_PROVIDER=auto

# Groq (free tier: https://console.groq.com). Keys _2 to _5 are optional
# and only used for rotation when the previous key is rate-limited.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (optional, free tier: https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# SambaNova (optional, free tier: https://cloud.sambanova.ai)
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=DeepSeek-V3.1

# Ollama (local fallback, https://ollama.com)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# Signal sources
NEWSAPI_AI_KEY=
SEMANTIC_SCHOLAR_API_KEY=
