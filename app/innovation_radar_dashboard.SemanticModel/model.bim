        "measures": [
          {
            "name": "Grounding Signal Count",
            "description": "Signals linked to the opportunity spaces in context.",
            "displayFolder": "Evidence",
            "expression": "DISTINCTCOUNT ( 'Opportunity Signals'[signal_id] )",
            "formatString": "#,0",
            "lineageTag": "45aac751-0f55-46de-8c9b-f5bbccf0d6b1"
          },
          {
            "name": "# Signals",
            "displayFolder": "Evidence",
            "expression": "COUNTROWS ( 'Signals' )",
            "formatString": "#,0",
            "lineageTag": "c61f8c47-5580-41c9-95a9-55e3ab816d68"
          },
          {
            "name": "# Sources",
            "displayFolder": "Evidence",
            "expression": "DISTINCTCOUNT ( 'Signals'[Source] )",
            "formatString": "#,0",
            "lineageTag": "a3e16e73-f259-4799-aa36-bf7d3b469aa6"
          },
          {
            "name": "Latest Signal Collected",
            "displayFolder": "Evidence",
            "expression": "MAX ( 'Signals'[Collected At] )",
            "formatString": "yyyy-mm-dd hh:nn",
            "lineageTag": "83a9f6a1-e211-4ab8-a249-038d0a89d5f6"
          },
          {
            "name": "% Fresh Signals",
            "description": "Share of signals published at most 30 days before they were collected.",
            "displayFolder": "Evidence",
            "expression": "DIVIDE ( CALCULATE ( [# Signals], KEEPFILTERS ( 'Signals'[Signal Age] = \"0-30 days\" ) ), [# Signals] )",
            "formatString": "0%",
            "lineageTag": "61d9b71d-4dd6-4b9a-8489-bdde08f9e980"
          }
        ],
        "partitions": [
          {
            "name": "Signals",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"signals.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Promoted, {}, each if _ = \"\" then null else _),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"id\", Int64.Type}, {\"source_name\", type text}, {\"source_url\", type text}, {\"signal_type\", type text}, {\"title\", type text}, {\"summary\", type text}, {\"published_date\", type text}, {\"collected_at\", type datetime}, {\"vertical_hint\", type text}, {\"published_on\", type date}}, \"en-US\"),",
                "    #\"Collected Date\" = Table.AddColumn(Typed, \"Collected Date\", each Date.From([collected_at]), type date),",
                "    #\"Signal Age Days\" = Table.AddColumn(#\"Collected Date\", \"Signal Age Days\", each if [published_on] = null or [Collected Date] = null then null else Duration.Days([Collected Date] - [published_on]), Int64.Type),",
                "    #\"Signal Age\" = Table.AddColumn(#\"Signal Age Days\", \"Signal Age\", each let d = [Signal Age Days] in if d = null then \"Unknown\" else if d <= 30 then \"0-30 days\" else if d <= 90 then \"31-90 days\" else if d <= 365 then \"3-12 months\" else \"Over 1 year\", type text),",
                "    #\"Signal Age Order\" = Table.AddColumn(#\"Signal Age\", \"Signal Age Order\", each if [Signal Age] = \"0-30 days\" then 1 else if [Signal Age] = \"31-90 days\" then 2 else if [Signal Age] = \"3-12 months\" then 3 else if [Signal Age] = \"Over 1 year\" then 4 else 5, Int64.Type),",
                "    #\"Removed Age Days\" = Table.RemoveColumns(#\"Signal Age Order\", {\"Signal Age Days\"}),",
                "    #\"Readable Values\" = Table.TransformColumns(#\"Removed Age Days\", {{\"signal_type\", each if _ = null then null else Text.Proper(Text.Replace(_, \"_\", \" \")), type text}, {\"vertical_hint\", each if _ = null then \"Unassigned\" else _, type text}})",
                "in",
                "    #\"Readable Values\""
              ],
              "type": "m"
            }
          }
        ]
