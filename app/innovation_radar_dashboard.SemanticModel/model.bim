        "lineageTag": "5c35c543-528a-417c-ab99-943c0ad13e74",
        "measures": [
          {
            "name": "Quadrant Threshold",
            "description": "Display only: same threshold as STRONG_THRESHOLD in pipeline/config.py, applied in the Scores query.",
            "displayFolder": "Quadrant",
            "expression": "7",
            "formatString": "0",
            "lineageTag": "5f9f1474-0de2-4153-8561-2d887e182160"
          },
          {
            "name": "Attractiveness Score",
            "description": "Weighted attractiveness 0-10. Averaged, so totals and vertical levels stay on the 0-10 scale.",
            "displayFolder": "Scores",
            "expression": "AVERAGE ( 'Scores'[Raw Attractiveness Score] )",
            "formatString": "0.0",
            "lineageTag": "b8c455a2-cbf3-4a69-bffb-580356a6b7f6"
          },
          {
            "name": "Right-to-Win Score",
            "displayFolder": "Scores",
            "expression": "AVERAGE ( 'Scores'[Raw Right-to-Win Score] )",
            "formatString": "0.0",
            "lineageTag": "b19ef1a0-959d-4435-8ce6-5138d0d34194"
          },
          {
            "name": "Urgency Score",
            "displayFolder": "Scores",
            "expression": "AVERAGE ( 'Scores'[Raw Urgency Score] )",
            "formatString": "0.0",
            "lineageTag": "01f0b38f-6774-4e20-8710-deaa2362e8a3"
          },
          {
            "name": "Market Signal Strength",
            "displayFolder": "Scores\\Sub-scores",
            "expression": "AVERAGE ( 'Scores'[Raw Market Signal Strength] )",
            "formatString": "0.0",
            "lineageTag": "a7f9e3e8-5e9b-4880-b7d4-fe0e2ee3b8fd"
          },
          {
            "name": "Source Diversity",
            "displayFolder": "Scores\\Sub-scores",
            "expression": "AVERAGE ( 'Scores'[Raw Source Diversity] )",
            "formatString": "0.0",
            "lineageTag": "2c6a7270-14ef-4880-8a0e-679f15c9ec5e"
          },
          {
            "name": "Evidence Quality",
            "displayFolder": "Scores\\Sub-scores",
            "expression": "AVERAGE ( 'Scores'[Raw Evidence Quality] )",
            "formatString": "0.0",
            "lineageTag": "e9584359-66d0-4bf6-b5bb-a4e9357aa3d8"
          },
          {
            "name": "Novelty Momentum",
            "displayFolder": "Scores\\Sub-scores",
            "expression": "AVERAGE ( 'Scores'[Raw Novelty Momentum] )",
            "formatString": "0.0",
            "lineageTag": "1da84d36-711a-4c9f-821f-6f14fa9b2bca"
          },
          {
            "name": "Strategic Relevance",
            "displayFolder": "Scores\\Sub-scores",
            "expression": "AVERAGE ( 'Scores'[Raw Strategic Relevance] )",
            "formatString": "0.0",
            "lineageTag": "6afdb027-f92d-4d7e-99e0-4270fe6d43e9"
          },
          {
            "name": "Attractiveness Rank",
            "displayFolder": "Scores",
            "expression": [
              "IF (",
              "    HASONEVALUE ( 'Opportunity Spaces'[id] ),",
              "    RANKX ( ALLSELECTED ( 'Opportunity Spaces' ), [Attractiveness Score], , DESC, DENSE )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "573b0839-23e2-4098-b5c1-49f856a3f826"
          },
          {
            "name": "# Opportunity Spaces",
            "displayFolder": "Portfolio",
            "expression": "COUNTROWS ( 'Scores' )",
            "formatString": "#,0",
            "lineageTag": "49ba1c4d-e57e-460c-988a-30c3303356a7"
          },
          {
            "name": "# Quick Wins",
            "displayFolder": "Quadrant",
            "expression": "CALCULATE ( [# Opportunity Spaces], KEEPFILTERS ( 'Scores'[Quadrant] = \"Quick Win\" ) )",
            "formatString": "#,0",
            "lineageTag": "4b97da2d-d991-4965-bbe2-59089936b703"
          },
          {
            "name": "# Strategic Bets",
            "displayFolder": "Quadrant",
            "expression": "CALCULATE ( [# Opportunity Spaces], KEEPFILTERS ( 'Scores'[Quadrant] = \"Strategic Bet\" ) )",
            "formatString": "#,0",
            "lineageTag": "b6574242-cfdf-4fc9-934e-1ed2328483b7"
          },
          {
            "name": "# Safe but not Hot",
            "displayFolder": "Quadrant",
            "expression": "CALCULATE ( [# Opportunity Spaces], KEEPFILTERS ( 'Scores'[Quadrant] = \"Safe but not Hot\" ) )",
            "formatString": "#,0",
            "lineageTag": "a41e27f4-82ed-49a4-9483-b6f4cfb01f0e"
          },
          {
            "name": "# Deprioritize",
            "displayFolder": "Quadrant",
            "expression": "CALCULATE ( [# Opportunity Spaces], KEEPFILTERS ( 'Scores'[Quadrant] = \"Deprioritize\" ) )",
            "formatString": "#,0",
            "lineageTag": "042cb66b-27eb-49c7-9689-cbbb23ce67af"
          },
          {
            "name": "% Quick Wins",
            "displayFolder": "Quadrant",
            "expression": "DIVIDE ( [# Quick Wins], [# Opportunity Spaces] )",
            "formatString": "0%",
            "lineageTag": "f6abffe4-191b-4eef-a4f8-29e4d5d294e7"
          },
          {
            "name": "Selected Opportunity",
            "displayFolder": "Text",
            "expression": [
              "IF (",
              "    HASONEVALUE ( 'Opportunity Spaces'[id] ),",
              "    SELECTEDVALUE ( 'Opportunity Spaces'[Label] ) & \"  ·  \" & SELECTEDVALUE ( 'Opportunity Spaces'[Vertical] )",
              "        & \"  ·  \" & SELECTEDVALUE ( 'Opportunity Spaces'[Use Case] ) & \"  ×  \" & SELECTEDVALUE ( 'Opportunity Spaces'[Technology] )",
              "        & \"  |  Attractiveness \" & FORMAT ( [Attractiveness Score], \"0.0\" )",
              "        & \"  ·  Right-to-win \" & FORMAT ( [Right-to-Win Score], \"0.0\" )",
              "        & \"  ·  \" & SELECTEDVALUE ( 'Scores'[Quadrant] ),",
              "    \"No opportunity space selected. Go to Decision Matrix, right-click a bubble or a table row, then Drill through > this page.\"",
              ")"
            ],
            "lineageTag": "ab455b72-05c3-4798-8eef-aac07a900ad4"
          },
          {
            "name": "Evidence Quality Justification",
            "displayFolder": "Text",
            "expression": "SELECTEDVALUE ( 'Scores'[Raw Evidence Quality Justification], \"No opportunity space selected. Go to Decision Matrix, right-click a bubble or a table row, then Drill through > this page.\" )",
            "lineageTag": "24bebbd8-741f-4789-88e4-54ec02c72e10"
          },
          {
            "name": "Strategic Relevance Justification",
            "displayFolder": "Text",
            "expression": "SELECTEDVALUE ( 'Scores'[Raw Strategic Relevance Justification], \"No opportunity space selected. Go to Decision Matrix, right-click a bubble or a table row, then Drill through > this page.\" )",
            "lineageTag": "99a75291-ad32-4bcc-b3b9-1d2bdea0fe0d"
          },
          {
            "name": "Right-to-Win Justification",
            "displayFolder": "Text",
            "expression": "SELECTEDVALUE ( 'Scores'[Raw Right-to-Win Justification], \"No opportunity space selected. Go to Decision Matrix, right-click a bubble or a table row, then Drill through > this page.\" )",
            "lineageTag": "38a92e1c-4cb9-4401-b109-e91bad3610ef"
          },
          {
            "name": "Next Action Strategist",
            "displayFolder": "Text",
            "expression": "SELECTEDVALUE ( 'Opportunity Spaces'[Next Action (Strategist)], \"No opportunity space selected. Go to Decision Matrix, right-click a bubble or a table row, then Drill through > this page.\" )",
            "lineageTag": "fa7ebb48-e270-4d0b-af85-efa11fe9b207"
          },
          {
            "name": "Next Action Sales",
            "displayFolder": "Text",
            "expression": "SELECTEDVALUE ( 'Opportunity Spaces'[Next Action (Sales)], \"No opportunity space selected. Go to Decision Matrix, right-click a bubble or a table row, then Drill through > this page.\" )",
            "lineageTag": "be01ae4e-c59f-42cd-b39d-2ca2ef065a0f"
          },
          {
            "name": "Next Action Presales",
            "displayFolder": "Text",
            "expression": "SELECTEDVALUE ( 'Opportunity Spaces'[Next Action (Presales)], \"No opportunity space selected. Go to Decision Matrix, right-click a bubble or a table row, then Drill through > this page.\" )",
            "lineageTag": "94d4a1f5-8428-44e5-afe3-4d9b59d077d1"
          },
          {
            "name": "Last Scored At",
            "displayFolder": "Freshness",
            "expression": "MAX ( 'Scores'[Scored At] )",
            "formatString": "yyyy-mm-dd hh:nn",
            "lineageTag": "a24a392f-6848-4186-968f-a76827cfee15"
          },
          {
            "name": "Data As Of",
            "displayFolder": "Freshness",
            "expression": [
              "\"Data \" & FORMAT ( MAX ( 'Export Info'[Exported At] ), \"yyyy-mm-dd hh:nn\" ) & \" UTC\"",
              "    & \" · scored \" & FORMAT ( [Last Scored At], \"yyyy-mm-dd\" )"
            ],
            "lineageTag": "b4fc258a-5566-4ceb-98c8-f5e61f739545"
          }
        ],
        "partitions": [
          {
            "name": "Scores",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"latest_scores.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Promoted, {}, each if _ = \"\" then null else _),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"id\", Int64.Type}, {\"opportunity_space_id\", Int64.Type}, {\"market_signal_strength\", type number}, {\"source_diversity\", type number}, {\"evidence_quality\", type number}, {\"evidence_quality_justification\", type text}, {\"novelty_momentum\", type number}, {\"strategic_relevance\", type number}, {\"strategic_relevance_justification\", type text}, {\"urgency_score\", type number}, {\"total_score\", type number}, {\"computed_at\", type datetime}, {\"right_to_win_id\", Int64.Type}, {\"portfolio_distance\", type text}, {\"right_to_win_score\", type number}, {\"matched_assets\", type text}, {\"justification\", type text}, {\"right_to_win_computed_at\", type datetime}}, \"en-US\"),",
                "    Quadrant = Table.AddColumn(Typed, \"Quadrant\", each let a = [total_score], r = [right_to_win_score], t = 7 in if a = null or r = null then null else if a >= t and r >= t then \"Quick Win\" else if a >= t then \"Strategic Bet\" else if r >= t then \"Safe but not Hot\" else \"Deprioritize\", type text),",
                "    #\"Quadrant Order\" = Table.AddColumn(Quadrant, \"Quadrant Order\", each if [Quadrant] = \"Quick Win\" then 1 else if [Quadrant] = \"Strategic Bet\" then 2 else if [Quadrant] = \"Safe but not Hot\" then 3 else if [Quadrant] = \"Deprioritize\" then 4 else 5, Int64.Type)",
                "in",
                "    #\"Quadrant Order\""
              ],
              "type": "m"
            }
          }
        ]
      },
