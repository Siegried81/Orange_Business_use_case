        "partitions": [
          {
            "name": "Opportunity Spaces",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"opportunity_spaces.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Promoted, {}, each if _ = \"\" then null else _),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"id\", Int64.Type}, {\"run_id\", type datetime}, {\"label\", type text}, {\"vertical\", type text}, {\"use_case\", type text}, {\"technology\", type text}, {\"created_at\", type datetime}, {\"last_refreshed\", type datetime}, {\"persona\", type text}, {\"geography\", type text}, {\"horizon\", type text}, {\"next_action\", type text}, {\"domain\", type text}, {\"buyer_persona\", type text}, {\"next_action_strategist\", type text}, {\"next_action_sales\", type text}, {\"next_action_presales\", type text}}, \"en-US\"),",
                "    #\"Display Label\" = Table.AddColumn(Typed, \"Display Label\", each if [run_id] = null then [label] else [label] & \" (\" & Date.ToText(Date.From([run_id]), \"yyyy-MM-dd\") & \")\", type text),",
                "    #\"Run Date\" = Table.AddColumn(#\"Display Label\", \"Run Date\", each Date.From([run_id]), type date),",
                "    #\"Horizon Order\" = Table.AddColumn(#\"Run Date\", \"Horizon Order\", each if [horizon] = \"Now\" then 1 else if [horizon] = \"Next\" then 2 else if [horizon] = \"Later\" then 3 else 4, Int64.Type)",
                "in",
                "    #\"Horizon Order\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Scores",
        "annotations": [
          {
            "name": "PBI_ResultType",
